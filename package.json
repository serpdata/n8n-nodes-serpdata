{
  "name": "@serpdata.dev/n8n-nodes-serpdata",
  "version": "0.1.0",
  "description": "n8n node for the SerpData API: Google search, images, news, shopping, patents, autocomplete, Trends and Google Maps places, reviews and photos.",
  "license": "MIT",
  "homepage": "https://github.com/serpdata/n8n-nodes-serpdata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serpdata/n8n-nodes-serpdata.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "serp",
    "google",
    "google maps",
    "reviews",
    "trends"
  ],
  "author": {
    "name": "SerpData",
    "email": "support@serpdata.dev"
  },
  "scripts": {
    "build": "n8n-node build",
    "build.types": "tsc --noEmit",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint.fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SerpDataApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SerpData/SerpData.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.53.3",
    "eslint": "9.32.0",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
